<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>كيف قتلنا كرة القدم — الجزء الأول (مجاني)</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@300;400;600;700;800&display=swap');
:root{--dg:#1a472a;--g:#c5a059;--bg:#0d1b1e;--lt:#f5f0e6;--gr:#888;--sh:0 2px 15px rgba(0,0,0,.08)}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Noto Sans Arabic',sans-serif;background:var(--bg);color:#333;line-height:1.9;font-size:18px}
a{text-decoration:none;color:inherit}

/* CTA Banner */
.cta-banner{position:fixed;top:0;left:0;right:0;background:linear-gradient(90deg,var(--dg),#0d1b1e);color:var(--lt);padding:12px 20px;text-align:center;z-index:1000;font-size:.95rem;border-bottom:2px solid var(--g);display:flex;justify-content:center;align-items:center;gap:15px;flex-wrap:wrap}
.cta-banner span{color:var(--g);font-weight:700}
.cta-banner .btn-small{background:var(--g);color:var(--bg);padding:6px 18px;border-radius:20px;font-weight:700;font-size:.85rem;transition:.3s}
.cta-banner .btn-small:hover{background:var(--lt);transform:translateY(-2px)}

/* Progress bar */
.progress-bar{position:fixed;top:50px;left:0;height:3px;background:var(--g);z-index:999;transition:width .3s}

/* Cover */
.cover{min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:40px 10px;background:var(--bg);position:relative;overflow:hidden;margin-top:50px}
.cover::before{content:'';position:absolute;top:0;left:0;right:0;bottom:0;background:radial-gradient(circle at 50% 30%,rgba(197,160,89,.08),transparent 60%);pointer-events:none}
.cover-badge{background:var(--g);color:var(--bg);padding:8px 24px;border-radius:30px;font-weight:700;font-size:.85rem;letter-spacing:1px;margin-bottom:30px;z-index:1}
.cover h1{font-size:3.2rem;color:var(--lt);font-weight:800;margin-bottom:15px;line-height:1.3;z-index:1}
.cover .subtitle{color:var(--g);font-size:1.3rem;font-weight:600;margin-bottom:40px;z-index:1}
.cover .author{color:var(--lt);font-size:1.1rem;opacity:.8;z-index:1}
.cover .year{color:var(--gr);margin-top:15px;font-size:1rem;z-index:1}

/* Preview badge */
.preview-badge{display:inline-block;background:#e74c3c;color:#fff;padding:6px 18px;border-radius:20px;font-size:.8rem;font-weight:700;margin-bottom:20px;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.05)}}

/* Content sections */
.title-page{min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:60px 40px;background:var(--bg);border:3px solid var(--g);margin:20px;border-radius:12px}
.title-page h2{font-size:2.8rem;color:var(--g);font-weight:800;margin-bottom:20px;line-height:1.4}
.title-page .tagline{color:var(--lt);font-size:1.15rem;margin-bottom:50px;max-width:500px}
.title-page .author{color:var(--g);font-weight:700;font-size:1.3rem;display:block;margin-bottom:10px}
.title-page .year{color:var(--gr);font-size:1.1rem}

.copyright-page{background:#fff;max-width:800px;margin:20px auto;padding:60px 50px;border-radius:12px;box-shadow:var(--sh);text-align:center}
.copyright-page h4{color:var(--dg);font-size:1.4rem;font-weight:700;margin-bottom:30px;padding-bottom:12px;border-bottom:2px solid var(--g);display:inline-block}
.copyright-page p{color:#555;margin-bottom:14px;font-size:.95rem;line-height:1.8}

.toc{background:#fff;padding:50px 30px;max-width:800px;margin:20px auto;border-radius:12px;box-shadow:var(--sh)}
.toc-header{background:var(--dg);color:#fff;padding:22px 30px;font-size:1.6rem;font-weight:700;margin:-50px -30px 35px;border-radius:12px 12px 0 0;text-align:center}
.toc-item{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px dashed #ddd;font-size:1.05rem;transition:.2s}
.toc-item:hover{padding-right:8px;color:var(--dg)}
.toc-item.part{font-weight:700;color:var(--dg);font-size:1.1rem;margin-top:15px;border-bottom:2px solid var(--g);padding-bottom:8px}
.toc-item.chapter{padding-right:25px;color:#555}
.toc-item .page{color:var(--gr);font-size:.9rem;min-width:40px;text-align:left}
.toc-item.locked{opacity:.5}
.toc-item.locked::after{content:'🔒';margin-right:8px;font-size:.8rem}

.part-divider{min-height:85vh;background:var(--dg);display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:60px 30px;margin:30px 10px;border-radius:12px;position:relative;overflow:hidden}
.part-divider::before{content:'';position:absolute;top:0;left:0;right:0;bottom:0;background:radial-gradient(circle at 50% 50%,rgba(197,160,89,.1),transparent 50%)}
.part-divider::after{content:'';width:120px;height:3px;background:var(--g);margin-top:25px;border-radius:2px;position:relative;z-index:1}
.part-divider .part-num{font-size:1.1rem;color:var(--g);margin-bottom:12px;font-weight:600;letter-spacing:2px;position:relative;z-index:1}
.part-divider .part-title{font-size:2.4rem;color:#fff;font-weight:800;position:relative;z-index:1;line-height:1.3}
.part-divider .part-sub{color:var(--lt);margin-top:15px;font-size:1.15rem;opacity:.85;max-width:500px;position:relative;z-index:1}

.chapter{background:#fff;max-width:800px;margin:25px auto;padding:50px 35px;border-radius:12px;box-shadow:var(--sh);position:relative}
.chapter-header{background:var(--dg);color:#fff;margin:-50px -35px 35px;padding:28px 35px;border-radius:12px 12px 0 0;border-bottom:4px solid var(--g);position:relative}
.chapter-header .part-label{color:var(--g);font-size:.85rem;font-weight:600;margin-bottom:8px;letter-spacing:1px}
.chapter-header h3{color:#fff;font-size:1.5rem;font-weight:700;line-height:1.4}
.chapter-header .ch-sub{color:var(--lt);margin-top:10px;font-size:1rem;opacity:.9}
.chapter-body p{margin-bottom:20px;text-align:justify;color:#444}
.chapter-body p:first-of-type::first-letter{font-size:2.5rem;font-weight:700;color:var(--dg);float:right;margin-left:12px;line-height:1}
.chapter-body blockquote{background:#f8f5e8;border-right:5px solid var(--g);padding:22px 25px;margin:30px 0;font-style:italic;color:var(--dg);font-weight:600;border-radius:0 10px 10px 0;line-height:2;position:relative;font-size:1.05rem}
.chapter-body blockquote::before{content:'"';position:absolute;top:-10px;right:15px;font-size:3rem;color:var(--g);opacity:.3;font-style:normal}
.chapter-body .stat{background:linear-gradient(135deg,#fff8e1,#fef3c7);color:var(--dg);padding:16px 22px;margin:25px 0;font-weight:700;border-radius:10px;border-right:5px solid var(--g);font-size:1rem;box-shadow:0 2px 8px rgba(197,160,89,.15)}
.chapter-body h4{font-size:1.25rem;font-weight:700;color:var(--dg);margin:35px 0 18px;padding-bottom:10px;border-bottom:2px solid var(--g);display:inline-block}
.chapter-body ul{margin:18px 30px 18px 0;list-style:none}
.chapter-body ul li{margin-bottom:12px;padding-right:25px;position:relative;color:#444}
.chapter-body ul li::before{content:'◆';position:absolute;right:0;color:var(--g);font-size:.7rem;top:5px}
.chapter-body table{width:100%;border-collapse:collapse;margin:25px 0;font-size:.95rem;box-shadow:var(--sh);border-radius:8px;overflow:hidden}
.chapter-body th{background:var(--dg);color:#fff;padding:14px 16px;text-align:right;font-weight:600}
.chapter-body td{padding:12px 16px;border-bottom:1px solid #eee;text-align:right;color:#444}
.chapter-body tr:nth-child(even){background:#f9f9f5}
.chapter-body tr:hover{background:#f5f0e6}

/* CTA Section at bottom */
.cta-section{background:linear-gradient(180deg,var(--dg),var(--bg));color:var(--lt);padding:80px 40px;margin:40px 10px;border-radius:12px;border:3px solid var(--g);text-align:center;position:relative;overflow:hidden}
.cta-section::before{content:'';position:absolute;top:0;left:0;right:0;bottom:0;background:radial-gradient(circle at 30% 70%,rgba(197,160,89,.08),transparent 50%)}
.cta-section h2{color:var(--g);font-size:2.2rem;margin-bottom:20px;font-weight:800;position:relative}
.cta-section p{font-size:1.1rem;margin-bottom:15px;opacity:.9;position:relative;max-width:600px;margin-left:auto;margin-right:auto}
.cta-section .features{text-align:right;max-width:500px;margin:30px auto;position:relative}
.cta-section .features li{margin-bottom:10px;padding-right:25px;position:relative;list-style:none}
.cta-section .features li::before{content:'✓';position:absolute;right:0;color:var(--g);font-weight:700}
.cta-section .price{font-size:2.5rem;color:var(--g);font-weight:800;margin:30px 0;position:relative}
.cta-section .price span{font-size:1rem;color:var(--gr);text-decoration:line-through;margin-right:10px}
.cta-btn{display:inline-block;background:var(--g);color:var(--bg);padding:18px 50px;border-radius:35px;font-size:1.3rem;font-weight:800;transition:.3s;position:relative;box-shadow:0 8px 25px rgba(197,160,89,.3)}
.cta-btn:hover{background:var(--lt);transform:translateY(-3px);box-shadow:0 12px 35px rgba(197,160,89,.4)}
.cta-note{font-size:.85rem;color:var(--gr);margin-top:15px;position:relative}

/* Footer */
.footer{text-align:center;padding:40px 20px;color:var(--gr);font-size:.9rem}
.footer a{color:var(--g)}

@media(max-width:600px){
.cover h1{font-size:2rem}
.cta-banner{font-size:.8rem;padding:8px}
.cta-section h2{font-size:1.6rem}
.cta-btn{padding:14px 35px;font-size:1.1rem}
.chapter{padding:30px 20px}
}
</style>
</head>
<body>

<!-- CTA Banner -->
<div class="cta-banner">
