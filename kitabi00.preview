</div>

<!-- Progress Bar -->
<div class="progress-bar" id="progress" style="width:0%"></div>

<section class="cover">
  <div class="cover-frame">
    <div class="corner tl"></div><div class="corner tr"></div>
    <div class="corner bl"></div><div class="corner br"></div>
    <div class="cover-inner-border"></div>
    <div class="cover-glow"></div>
    <div class="top-line"></div>
    <div class="cover-badge">دراسة في أزمة اللعبة الأكثر شعبية</div>
    <div class="ball-wrap">
      <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="ballGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#c5a059;stop-opacity:.95"/>
            <stop offset="100%" style="stop-color:#8a6e30;stop-opacity:.9"/>
          </linearGradient>
        </defs>
        <circle cx="50" cy="50" r="46" fill="none" stroke="url(#ballGrad)" stroke-width="2.5"/>
        <path d="M50 15 L61 38 L85 38 L66 54 L73 78 L50 64 L27 78 L34 54 L15 38 L39 38 Z" fill="none" stroke="url(#ballGrad)" stroke-width="1.8" opacity=".7"/>
        <path d="M50 25 L57 41 L74 41 L61 52 L66 68 L50 58 L34 68 L39 52 L26 41 L43 41 Z" fill="url(#ballGrad)" opacity=".15"/>
        <path d="M50 15 L50 25 M61 38 L57 41 M85 38 L74 41 M66 54 L61 52 M73 78 L66 68 M27 78 L34 68 M34 54 L39 52 M15 38 L26 41 M39 38 L43 41" stroke="url(#ballGrad)" stroke-width="1" opacity=".5"/>
        <circle cx="35" cy="30" r="8" fill="#c5a059" opacity=".08"/>
      </svg>
    </div>
    <h1>كيف قتلنا</h1>
    <div class="title-accent">كرة القدم</div>
    <p class="cover-sub">من جنون الجماهير<br>إلى صمت المدرجات</p>
    <div class="mid-line"></div>
    <div class="cover-author">زياد لنداري</div>
    <div class="cover-year">2026</div>
    <div class="deco-bottom">⚽ &nbsp; ⚽ &nbsp; ⚽</div>
  </div>
</section>

<div style="text-align:center;margin:20px 0">
<span class="preview-badge">🎁 معاينة مجانية — الجزء الأول فقط</span>
</div>

<section class="title-page">
  <h2>كيف قتلنا كرة القدم</h2>
  <div class="tagline">من جنون الجماهير إلى صمت المدرجات<br>دراسة في أزمة اللعبة الأكثر شعبية</div>
  <span class="author">زياد لنداري</span>
